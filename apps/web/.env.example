# Copy to .env.local and adjust for your machine.
# Only NEXT_PUBLIC_* vars are inlined into the browser bundle.

# NestJS API base URL (REST + socket.io)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public site origin, used for metadataBase / OG image URLs (must be absolute)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
