# Copy to .env.local and adjust for your machine.
# Loaded by ConfigModule in order: .env.local, then .env (first match wins).

# HTTP + socket.io listen port
PORT=3001

# Redis connection string (Laragon default, no auth)
REDIS_URL=redis://127.0.0.1:6379

# Web app origin allowed for CORS and socket.io
WEB_ORIGIN=http://localhost:3000
